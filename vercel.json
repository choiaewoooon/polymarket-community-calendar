{
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/gamma/:path*",
      "destination": "https://gamma-api.polymarket.com/:path*"
    },
    {
      "source": "/99market",
      "destination": "/index.html"
    },
    {
      "source": "/komarket",
      "destination": "/index.html"
    }
  ]
}
